# Local server
MASIL_HOST=127.0.0.1
MASIL_PORT=8000
MASIL_MCP_PATH=/mcp

# none: local-only development; static: bearer token; oauth_client: Claude client credentials
# github: optional GitHub login flow (requires a GitHub OAuth app)
MASIL_AUTH_MODE=none
MASIL_STATIC_TOKEN=replace-with-a-long-random-token

# Recommended production mode for the Claude custom connector.
# Enter these same two values in Claude's advanced OAuth fields.
MASIL_OAUTH_CLIENT_ID=masil-claude-team
MASIL_OAUTH_CLIENT_SECRET=replace-with-a-long-random-secret
MASIL_OAUTH_REDIRECT_URI=https://claude.ai/api/mcp/auth_callback

# Required only when MASIL_AUTH_MODE=github
MASIL_GITHUB_CLIENT_ID=
MASIL_GITHUB_CLIENT_SECRET=
MASIL_PUBLIC_URL=https://masil-mcp.summit1123.co.kr

